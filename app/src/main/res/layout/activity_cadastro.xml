<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- Barra superior c/ a logo e voltar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start|center_vertical"
                android:gravity="center"
                android:text="@string/return_txt"
                android:textColor="@color/levit_text_primary"
                android:textSize="20sp"
                android:contentDescription="@string/return_txt_desc" />

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:src="@drawable/levit_logo_text"
                android:contentDescription="@string/logo_desc" />

        </FrameLayout>

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/cadastro_title"
            android:textColor="@color/levit_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/cadastro_desc"
            android:textColor="@color/levit_text_secondary"
            android:textSize="14sp" />

        <!-- Nome completo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/cadastro_name_field_title"
            android:textColor="@color/levit_text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etNomeCompleto"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_edit_text"
            android:hint="@string/cadastro_name_field_example"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:textColor="@color/levit_text_primary"
            android:textColorHint="@color/levit_hint"
            android:textSize="15sp" />

        <!-- E-mail -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/cadastro_email_field_title"
            android:textColor="@color/levit_text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_edit_text"
            android:hint="@string/email_field_example"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:textColor="@color/levit_text_primary"
            android:textColorHint="@color/levit_hint"
            android:textSize="15sp" />

        <!-- CPF ou CNPJ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/cadastro_cpfcnpj_field_title"
            android:textColor="@color/levit_text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etCpfCnpj"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_edit_text"
            android:hint="@string/cadastro_cpfcnpj_field_example"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/levit_text_primary"
            android:textColorHint="@color/levit_hint"
            android:textSize="15sp" />

        <!-- Senha -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/password_field_title"
            android:textColor="@color/levit_text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etSenha"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_edit_text"
            android:hint="@string/cadastro_password_field_example"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textColor="@color/levit_text_primary"
            android:textColorHint="@color/levit_hint"
            android:textSize="15sp" />


        <!-- Confirmar palavra-passe -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/cadastro_cpassword_field_title"
            android:textColor="@color/levit_text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etConfirmarSenha"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_edit_text"
            android:hint="@string/cadastro_cpassword_field_example"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textColor="@color/levit_text_primary"
            android:textColorHint="@color/levit_hint"
            android:textSize="15sp" />

        <!-- Ação principal -->
        <Button
            android:id="@+id/btnCriarConta"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_primary"
            android:elevation="0dp"
            android:text="@string/cadastro_button_title"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cadastro_login_txt1"
                android:textColor="@color/levit_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvFacaLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cadastro_login_txt2"
                android:textColor="@color/levit_purple"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
